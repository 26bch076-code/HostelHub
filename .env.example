# ==============================================================================
# HostelHub - Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemma AI Configuration (Backend Only - Never exposed to frontend)
# ------------------------------------------------------------------------------
# You can use either Google AI Studio OR Groq Cloud to run Google Gemma 2:
#
# Option A: Google AI Studio (Free Tier)
# Get a free API key at: https://aistudio.google.com/
GEMMA_API_KEY=your_google_ai_studio_api_key_here

# Option B: Groq Cloud (Free Tier - ultra-fast Gemma 2 9B inference)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Optional - for persistent cloud auth/database)
# ------------------------------------------------------------------------------
# ONLY use your public "anon" key with the VITE_ prefix.
# Never expose your Supabase "service_role" secret key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
